+@pytest.mark.asyncio
+async def test_background_cancel_preserves_status_and_cleans_task(monkeypatch):
+    serving = _make_background_serving(monkeypatch)
+    producer_started = asyncio.Event()
+
+    async def generate(*args, **kwargs):
+        producer_started.set()
+        await asyncio.Event().wait()
+        yield
+
+    serving.engine_client.generate.side_effect = generate
+    request = ResponsesRequest(input="hi", background=True, max_output_tokens=4)
+    response = await serving.create_responses(request)
+    assert isinstance(response, ResponsesResponse)
+    task = serving.background_tasks[response.id]
+    cleanup_done = asyncio.Event()
+    task.add_done_callback(lambda _: cleanup_done.set())
+    try:
+        await asyncio.wait_for(producer_started.wait(), 1)
+        cancelled = await asyncio.wait_for(serving.cancel_responses(response.id), 1)
+        await asyncio.wait_for(cleanup_done.wait(), 1)
+        assert cancelled is response
+        assert cancelled.status == "cancelled"
+        assert response.id not in serving.background_tasks
+    finally:
+        if not task.done():
+            task.cancel()
+        await asyncio.gather(task, return_exceptions=True)
