+@pytest.mark.asyncio
+@pytest.mark.parametrize("status", ["completed", "cancelled", "incomplete", "failed"])
+@pytest.mark.parametrize("raises", [False, True])
+async def test_background_failure_preserves_terminal_state(status, raises):
+    serving = _make_serving_instance()
+    request = ResponsesRequest(input="hi", background=True)
+    response = ResponsesResponse.from_request(
+        request,
+        SamplingParams(max_tokens=4),
+        model_name="test-model",
+        created_time=1,
+        output=[],
+        status="queued",
+        usage=None,
+    )
+    serving.response_store[response.id] = response
+    unrelated = response.model_copy(update={"id": "unrelated"})
+    serving.response_store["unrelated"] = unrelated
+    producer_started = asyncio.Event()
+    release_producer = asyncio.Event()
+
+    async def fail(*args, **kwargs):
+        producer_started.set()
+        await release_producer.wait()
+        if raises:
+            raise EngineGenerateError()
+        return serving.create_error_response("generation failed")
+
+    serving.responses_full_generator = fail
+    task = asyncio.create_task(serving._run_background_request(request))
+    try:
+        await asyncio.wait_for(producer_started.wait(), 1)
+        async with serving.response_store_lock:
+            response.status = status
+        release_producer.set()
+        await asyncio.wait_for(task, 1)
+        assert await serving.retrieve_responses(response.id, None, False) is response
+        assert response.status == status
+        assert serving.response_store["unrelated"] is unrelated
+    finally:
+        if not task.done():
+            task.cancel()
+        await asyncio.gather(task, return_exceptions=True)
+
