+class _ObservedFailedFuture(asyncio.Future):
+    def __init__(self):
+        super().__init__()
+        self.exception_calls = 0
+        self.cancel_calls = 0
+
+    def exception(self):
+        self.exception_calls += 1
+        return super().exception()
+
+    def cancel(self, *args, **kwargs):
+        self.cancel_calls += 1
+        return super().cancel(*args, **kwargs)
+
