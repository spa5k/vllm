+@pytest.mark.parametrize("hash_fn", [sha256, sha256_cbor])
+def test_prompt_embed_dtype_separates_prefix_cache_entries(hash_fn):
+    block_size = 16
+    manager = make_kv_cache_manager(
+        make_kv_cache_config(block_size, 6),
+        max_model_len=128,
+        enable_caching=True,
+        hash_block_size=block_size,
+    )
+    words = torch.full((33, 64), 0x3C00, dtype=torch.int16)
+    fp16 = words.view(torch.float16).clone()
+    bf16 = words.view(torch.bfloat16).clone()
+    assert torch.equal(fp16.view(torch.int16), bf16.view(torch.int16))
+    assert fp16[0, 0] != bf16[0, 0]
+
+    first = make_request("first", None, block_size, hash_fn, prompt_embeds=fp16)
+    assert len(first.block_hashes) == 2
+    computed, num_computed, _ = manager.get_computed_blocks(first)
+    assert num_computed == 0
+    assert manager.allocate_slots(first, first.num_tokens, 0, computed) is not None
+    manager.free(first)
+
+    same = make_request("same", None, block_size, hash_fn, prompt_embeds=fp16.clone())
+    computed, num_computed, _ = manager.get_computed_blocks(same)
+    assert same.block_hashes == first.block_hashes
+    assert len(computed.blocks[0]) == 2
+    assert num_computed == 2 * block_size
+
+    different = make_request("different", None, block_size, hash_fn, prompt_embeds=bf16)
+    assert len(different.block_hashes) == 2
+    computed, num_computed, _ = manager.get_computed_blocks(different)
+    assert computed.get_block_ids() == ([],)
+    assert num_computed == 0
+    assert different.block_hashes != first.block_hashes
 
 
