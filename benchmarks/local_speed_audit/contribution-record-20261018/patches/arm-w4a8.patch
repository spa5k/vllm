+def test_cpu_int4_moe_swigluoai_interleaved():
+    """GPT-OSS gate/up pairs must stay interleaved through W4A8."""
+    set_random_seed(0)
+    M, N, K, E, topk, group_size = 2, 256, 512, 1, 1, -1
+    activation_dtype = torch.bfloat16
+    activation = MoEActivation.SWIGLUOAI
+    a = torch.randn(M, K, dtype=activation_dtype) / (K**0.5)
+    w13_packed, w2_packed, w13_ref, w2_ref, w13_bias, w2_bias = (
+        _make_int4_moe_weights(E, N, K, group_size, has_bias=True)
+    )
+    topk_weight = torch.ones((M, topk), dtype=activation_dtype)
+    topk_ids = torch.zeros((M, topk), dtype=torch.long)
+
+    ref_out = ref_int4_moe(
+        a,
+        w13_ref,
+        w2_ref,
+        topk_weight,
+        topk_ids,
+        activation,
+        w13_bias,
+        w2_bias,
+    )
+    out = torch.ops._C.dynamic_4bit_int_moe(
+        a,
+        topk_ids,
+        topk_weight,
+        w13_packed,
+        w2_packed,
+        K,
+        N,
+        group_size,
+        False,
+        CPUExpertsInt4._activation_kind(activation),
+    )
+
+    torch.testing.assert_close(
+        ref_out,
+        out,
