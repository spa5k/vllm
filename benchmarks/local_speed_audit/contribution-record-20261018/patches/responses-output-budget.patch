+    async def test_http_builtin_tool_budget(
+        self, serving_responses_instance, stream, case
+    ):
+        """Keep one output cap across real JSON/SSE routes and scripted turns."""
+        encoding = get_encoding()
+        tool_tokens = encoding.encode(
+            "<|channel|>analysis<|message|>Need to search for the requested "
+            "information before giving a precise final answer.<|end|>"
+            "<|start|>assistant to=browser.search<|channel|>commentary"
+            '<|constrain|>json<|message|>{"query":"vllm"}<|call|>',
+            allowed_special="all",
+        )
+        final_tokens = encoding.encode(
+            "<|channel|>final<|message|>The search is complete. This is the "
+            "final answer with enough fixed text for the output limit control."
+            "<|return|>",
+            allowed_special="all",
+        )
+        assert 16 <= len(tool_tokens) <= 128
+        assert 16 <= len(final_tokens) <= 128
+        remainder = len(final_tokens) - 1
+        scripts = [tool_tokens, final_tokens]
+        if case == "tool_boundary":
+            cap, expected_limits, searches = len(tool_tokens), [len(tool_tokens)], 0
+        elif case == "remaining":
+            cap = len(tool_tokens) + len(final_tokens)
+            expected_limits, searches = [cap, len(final_tokens)], 1
+        elif case == "final_boundary":
+            cap, scripts = len(final_tokens), [final_tokens]
+            expected_limits, searches = [cap], 0
+        else:
+            cap = len(tool_tokens) + remainder
+            expected_limits, searches = [cap, remainder], 1
+        expected_status = (
+            "incomplete" if case in {"tool_boundary", "truncated"} else "completed"
+        )
+        serving = serving_responses_instance
