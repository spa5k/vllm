+
+        async def generate(engine_input, sampling_params, *args, **kwargs):
+            script = scripts[len(limits)]
+            limit = sampling_params.max_tokens
+            limits.append(limit)
+            token_ids = script[:limit]
+            emitted.append(len(token_ids))
